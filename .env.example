# Supabase Configuration - Self-Hosted danpearson.net
#
# Self-hosted Supabase infrastructure routing:
# - API (Database, Auth): api.danpearson.net
# - Edge Functions: functions.danpearson.net
# - Kong Gateway: Handles routing between services
#
# For self-hosted setup:
VITE_SUPABASE_URL=https://api.danpearson.net
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Functions URL (separate from API for self-hosted)
VITE_FUNCTIONS_URL=https://functions.danpearson.net

# Optional: Sentry error tracking (client). Leave unset for a graceful no-op.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Override auto-detected environment (development | staging | production):
# VITE_SENTRY_ENVIRONMENT=production
#
# Build-time only (NOT VITE_ prefixed, never exposed to the client) - required
# only to upload source maps to Sentry during a production build:
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project

# Optional: Error Tracking (custom endpoint)
# VITE_ERROR_TRACKING_ENDPOINT=https://your-error-endpoint.com
# VITE_ERROR_TRACKING_DEV=false
# VITE_ERROR_SAMPLE_RATE=0.1

# Optional: Build Information
# VITE_BUILD_VERSION=1.0.0

# Optional: Logging Configuration
# VITE_LOG_LEVEL=info

# Note: NEVER commit your actual .env file to version control
# Copy this file to .env and replace with your actual values
