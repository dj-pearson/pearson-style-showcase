# danpearson.net edge functions: environment
# Copy to .env and fill in. docker-compose.yml loads the whole file (env_file),
# and deployment/deploy-coolify.sh checks it before deploying. In Coolify, set
# the same names under the service's Environment Variables.
# NEVER commit .env.
#
# Every name below is one the code actually reads (Deno.env.get in
# supabase/functions or server.ts). The server logs missing names at startup
# and lists them under "config" on /_health (names only, never values).

# ============================================
# Required: the server reports "degraded" without these
# ============================================

# Self-hosted Supabase (Kong) URL
SUPABASE_URL=https://api.danpearson.net

# Supabase anon and service role keys (Supabase dashboard > Settings > API).
# The service role key bypasses RLS: keep it server-side only.
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret the anon/service keys were signed with. server.ts verifies every
# non-public function call against it and answers 503 when it is missing.
# SUPABASE_JWT_SECRET is read first; JWT_SECRET is accepted as a fallback.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ============================================
# Server
# ============================================

PORT=8000
DOMAIN=functions.danpearson.net
API_GATEWAY_URL=https://api.danpearson.net

# Where functions call other functions (invoke-function.ts)
FUNCTIONS_URL=https://functions.danpearson.net

# Browser origins allowed by CORS (comma-separated)
# ALLOWED_ORIGINS=https://danpearson.net,https://www.danpearson.net

# Per-request deadline. Requests past it get a 504. Defaults: 60s, with longer
# built-in limits for the AI pipelines and maintenance-runner (see server.ts).
# FUNCTION_TIMEOUT_MS=60000
# FUNCTION_TIMEOUTS=generate-ai-article=300000,maintenance-runner=600000

# Container memory cap used by docker-compose.yml (default 1g)
# EDGE_MEM_LIMIT=1g

# Log level for _shared/production-logger.ts: debug, info, warn, error
# LOG_LEVEL=info
# DENO_ENV=production

# ============================================
# Email
# ============================================

# Resend API key. The code reads RESEND_API (not RESEND_API_KEY):
# send-contact-email, newsletter-signup, newsletter-confirm, health-check.
RESEND_API=your-resend-api-key

# Contact form delivery (send-contact-email). CONTACT_FROM must be a sender
# verified with Resend; a resend.dev sender only delivers to the account owner.
# CONTACT_EMAIL=you@example.com
# CONTACT_FROM=Dan Pearson <noreply@danpearson.net>

# SMTP for ticket replies and notifications (send-ticket-email,
# send-notification-email). A mailbox's own SMTP settings override these.
AMAZON_SMTP_ENDPOINT=email-smtp.us-east-1.amazonaws.com
AMAZON_SMTP_USER_NAME=your-smtp-username
AMAZON_SMTP_PASSWORD=your-smtp-password
# SMTP_TIMEOUT_MS=30000

# Shared secret for the Make.com inbound email webhook (receive-email)
MAKE_WEBHOOK_SECRET=your-make-webhook-secret

# Newsletter confirm/unsubscribe token signing key
NEWSLETTER_TOKEN_SECRET=your-newsletter-token-secret

# ============================================
# AI providers
# ============================================
# The key name for each model is stored per row in ai_model_configs
# (api_key_secret_name), so set whichever names your rows use. The seeded rows
# use these; there is no ANTHROPIC_API_KEY or OPENAI_API_KEY lookup anywhere.
CLAUDE_API_KEY=your-claude-api-key
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEY_FREE=your-free-tier-gemini-key
# LOVABLE_API_KEY=your-lovable-key

# Amazon pipeline and API checks (amazon-article-pipeline, test-api-setup)
# SERPAPI_KEY=your-serpapi-key
# GOOGLE_SEARCH_API_KEY=your-google-cse-key
# GOOGLE_SEARCH_ENGINE_ID=your-cse-id
# DATAFORSEO_API_LOGIN=
# DATAFORSEO_API_PASSWORD=

# ============================================
# Other features
# ============================================

# Secure Vault encryption key.
# CRITICAL: once set, DO NOT CHANGE it or existing vault data can't be read.
VAULT_ENCRYPTION_KEY=your-secure-random-key-here

# oauth-proxy
# OAUTH_STATE_SECRET=
# FRONTEND_URL=https://danpearson.net
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# google-indexing (service account JSON on one line)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Rebuild hook fired after publishing (site-publish.ts)
# CLOUDFLARE_PAGES_DEPLOY_HOOK_URL=

# IndexNow key (public by design; defaults to the key in public/<key>.txt)
# INDEXNOW_KEY=

# optimize-image source caps
# OPTIMIZE_IMAGE_MAX_BYTES=26214400
# OPTIMIZE_IMAGE_MAX_PIXELS=25000000

# Coolify integration (coolify-health, coolify-proxy)
# COOLIFY_API_URL=
# COOLIFY_BASE_URL=
# COOLIFY_API_TOKEN=

# ============================================
# Security notes
# ============================================
# 1. Never commit this file with real values.
# 2. In production, set these as secrets in Coolify.
# 3. Rotate keys regularly and use different keys per environment.
# 4. The service role key and JWT secret grant full database access.
