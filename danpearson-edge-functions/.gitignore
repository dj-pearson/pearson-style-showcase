# Environment variables - NEVER commit these!
.env
.env.local
.env.production
.env.development
.env.*.local

# Deno cache. deno.lock is committed on purpose: the Dockerfile checks
# every remote import against it when the image is built.
.deno_cache/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/
*.tmp

# Build artifacts
dist/
build/
